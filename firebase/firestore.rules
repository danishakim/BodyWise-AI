rules_version = '2';

// BodyWise AI: Firestore security rules.
// Principle: users own everything under /users/{uid}; anything derived (metrics,
// daily totals, AI plans, coach replies, usage) is written only by Cloud Functions
// (Admin SDK bypasses rules), so clients can never fake calories or AI output.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function data() { return request.resource.data; }
    function isDateId(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function between(v, lo, hi) { return v is number && v >= lo && v <= hi; }
    function changedOnly(keys) { return data().diff(resource.data).affectedKeys().hasOnly(keys); }

    // Profile fields a client may write. Everything else on the user doc
    // (latestMetrics, currentWeightKg, activePlanId, createdAt) is server-only.
    function profileKeys() {
      return ['displayName', 'sex', 'birthYear', 'heightCm', 'activityLevel', 'goal', 'prefs',
              'units', 'locale', 'timeZone', 'theme', 'notifications', 'consent',
              'updatedAt', 'schemaVersion'];
    }
    function validProfile(d) {
      return d.sex in ['male', 'female']
        && d.birthYear is int && d.birthYear >= 1920 && d.birthYear <= 2013   // age 13+
        && between(d.heightCm, 120, 230)
        && d.activityLevel in ['sedentary', 'light', 'moderate', 'active', 'very_active']
        && d.goal.type in ['lose', 'maintain', 'gain']
        && (d.goal.get('targetKg', null) == null || between(d.goal.targetKg, 30, 300))
        && d.prefs.halal is bool && d.prefs.vegetarian is bool && d.prefs.puasaMode is bool
        && between(d.prefs.budgetRm, 5, 300)
        && d.updatedAt == request.time;
    }
    function validMeal(m) {
      return m.keys().hasOnly(['name', 'foodId', 'servings', 'slot', 'kcal', 'proteinG', 'carbsG',
                               'fatG', 'source', 'confidence', 'loggedAt'])
        && m.name is string && m.name.size() > 0 && m.name.size() <= 120
        && between(m.servings, 0.25, 10)
        && between(m.kcal, 0, 5000)
        && between(m.get('proteinG', 0), 0, 500)
        && between(m.get('carbsG', 0), 0, 1000)
        && between(m.get('fatG', 0), 0, 500)
        && m.slot in ['breakfast', 'lunch', 'snack', 'dinner', 'sahur', 'iftar', 'moreh']
        && m.source in ['plan', 'manual', 'snap_tm', 'snap_gemini', 'menu_scan'];
    }

    // ---------- user-owned data ----------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && data().keys().hasOnly(profileKeys()) && validProfile(data());
      allow update: if isOwner(uid) && changedOnly(profileKeys()) && validProfile(data());
      allow delete: if false;  // account deletion = Cloud Function recursive delete (PDPA)

      // One weigh-in per local day: the date IS the document id (idempotent upsert).
      match /weighIns/{date} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isDateId(date)
          && data().keys().hasOnly(['date', 'kg', 'source', 'createdAt'])
          && data().date == date
          && between(data().kg, 30, 300)
          && data().source in ['manual', 'scale', 'import'];
        allow delete: if isOwner(uid);
      }

      // Daily summary is server-maintained (recomputed from meals by a Cloud Function).
      match /days/{date} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /meals/{mealId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid) && isDateId(date) && validMeal(data())
            && data().loggedAt == request.time;
          allow update: if isOwner(uid) && validMeal(data())
            && changedOnly(['servings', 'slot', 'kcal', 'proteinG', 'carbsG', 'fatG', 'name']);
          allow delete: if isOwner(uid);
        }
      }

      // Kenduri events: client writes the inputs, the server writes `result`.
      match /events/{eventId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validEvent(data()) && !('result' in data());
        allow update: if isOwner(uid) && validEvent(data())
          && data().get('result', null) == resource.data.get('result', null);
        allow delete: if isOwner(uid);
      }
      function validEvent(e) {
        return e.keys().hasOnly(['name', 'date', 'extraKcal', 'daysBefore', 'daysAfter', 'status', 'result', 'createdAt'])
          && e.name is string && e.name.size() <= 40
          && isDateId(e.date)
          && between(e.extraKcal, 100, 5000)
          && e.daysBefore is int && e.daysBefore >= 0 && e.daysBefore <= 7
          && e.daysAfter is int && e.daysAfter >= 0 && e.daysAfter <= 7
          && e.status in ['planned', 'active', 'done', 'cancelled'];
      }

      // Server-only (AI output, achievements, quotas).
      match /plans/{planId}        { allow read: if isOwner(uid); allow write: if false; }
      match /coachMessages/{msgId} { allow read: if isOwner(uid); allow write: if false; }
      match /achievements/{id}     { allow read: if isOwner(uid); allow write: if false; }
      match /usage/{date}          { allow read: if isOwner(uid); allow write: if false; }
    }

    // ---------- shared, read-only catalogues ----------
    match /foods/{foodId}   { allow read: if signedIn(); allow write: if false; }
    match /config/{docId}   { allow read: if signedIn(); allow write: if false; }

    // Deny everything else by default.
    match /{document=**} { allow read, write: if false; }
  }
}
