# Copy this file to .env and fill in your values. Never commit .env.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# Free key from https://aistudio.google.com/apikey. Leave empty to run in demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Backup models tried in order if the main one is overloaded or retired
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest

# Optional: your Teachable Machine image model's shareable link
# (e.g. https://teachablemachine.withgoogle.com/models/AbCdEf123/).
# Name the classes exactly like the food ids in bodywise/foods.py (nasi_lemak, roti_canai, ...).
TM_MODEL_URL=

# Supabase (Project Settings → API Keys). Leave empty to keep data only on the device.
# VITE_* values are PUBLIC: Vite builds them into the web app. Row-Level Security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# SECRET: server only (AI rate limits). Never prefix it with VITE_ and never paste it anywhere public.
SUPABASE_SECRET_KEY=

# AI cost protection (per visitor IP, plus a global daily circuit breaker → demo mode)
AI_RATE_LIMIT_PER_MIN=10
AI_DAILY_PER_IP=50
AI_DAILY_CAP=500

# Set to 1 only when running behind exactly one reverse proxy. Not needed on Vercel.
TRUST_PROXY=0
